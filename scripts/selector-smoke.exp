#!/usr/bin/expect -f
set timeout 20
set root [file normalize [file join [file dirname [info script]] ..]]
set evidence [lindex $argv 0]
if {$evidence eq ""} { error "usage: expect scripts/selector-smoke.exp /tmp/evidence-directory" }
file mkdir $evidence
set env(PI_CODING_AGENT_DIR) [file join [file normalize $evidence] agent]
set env(PI_OFFLINE) 1
set env(TERM) xterm-256color
log_file -noappend [file join $evidence terminal.log]

proc launch {} {
  global root spawn_id
  spawn -noecho pi --offline --no-extensions --no-mcp --no-skills --no-prompt-templates --no-context-files --no-themes --no-session --tui-mode regular -e [file join $root tests tui-provider.ts] -e [file join $root index.ts] --provider compact-smoke --model reasoner
  stty rows 35 columns 110 < $spawn_out(slave,name)
  expect {
    -re {compact-smoke|reasoner} {}
    timeout { error "Pi startup timed out" }
  }
  after 800
}

proc stop {} {
  global spawn_id
  send -- "\003"
  after 300
  send -- "\003"
  expect {
    eof {}
    timeout { error "Pi did not exit" }
  }
}

launch
expect {
  -re {Compaction follows the main model and thinking level} {}
  timeout { error "default startup notification not shown" }
}
send -- "/compact-model\r"
expect {
  -re {Compaction model} {}
  timeout { error "model selector not shown" }
}
send -- "compact-smoke/reasoner"
after 300
send -- "\r"
expect {
  -re {Choose thinking level} {}
  timeout { error "thinking selector not shown" }
}
after 200
send -- "\r"
expect {
  -re {Compaction model set} {}
  timeout { error "settings not saved" }
}
send -- "/reload\r"
after 1200
send -- "/compact-model\r"
expect {
  -re {current: compact-smoke/reasoner.*medium} {}
  timeout { error "reload did not restore saved settings" }
}
send -- "\033"
after 200
stop

launch
expect {
  -re {Compaction model: compact-smoke/reasoner.*medium} {}
  timeout { error "configured startup notification not shown" }
}
send -- "/compact-model\r"
expect {
  -re {current: compact-smoke/reasoner.*medium} {}
  timeout { error "new process did not restore saved settings" }
}
send -- "compact-smoke/plain"
after 300
send -- "\r"
expect {
  -re {Compaction model set: compact-smoke/plain.*off} {}
  timeout { error "plain model did not skip thinking selection" }
}
send -- "/compact-model\r"
expect {
  -re {current: compact-smoke/plain.*off} {}
  timeout { error "plain model settings not restored" }
}
send -- "Follow main conversation model"
after 300
send -- "\r"
expect {
  -re {Compaction follows the main model and thinking level} {}
  timeout { error "default mode not restored" }
}
send -- "/reload\r"
expect {
  -re {Compaction follows the main model and thinking level} {}
  timeout { error "default mode not restored after reload" }
}
stop
puts "Selector smoke passed. Evidence: $evidence"
